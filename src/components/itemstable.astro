---
import { getCollection } from 'astro:content';

const entries = await getCollection('docs');

const items = entries
	.filter((entry) => entry.id.startsWith('equipment/'))
	.filter((entry) => entry.id !== 'equipment/index')
	.map((entry) => {
		const rawType = String(entry.data.type ?? '').trim();

		const type = rawType
			? rawType.charAt(0).toUpperCase() + rawType.slice(1).toLowerCase()
			: '';

		return {
			name: entry.data.title,
			slug: entry.id.replace(/^equipment\//, ''),

			type,
			typeValue: rawType.toLowerCase(),

			weight: entry.data.weight ?? '',

			armor: entry.data.armor,
			attack: entry.data.attack,
			defense: entry.data.defense,
			speed: entry.data.speed,
			range: entry.data.range,

			requirement: entry.data.requirement ?? '',
			image: entry.data.image ?? '',
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="items-table">

	<div class="controls">

		<input
			id="item-search"
			type="search"
			placeholder="Search equipment..."
			aria-label="Search equipment"
		/>

		<select
			id="item-type"
			aria-label="Filter equipment by type"
		>

			<option value="all">
				All types
			</option>

			{
				[
					...new Set(
						items
							.map((item) => ({
								value: item.typeValue,
								label: item.type,
							}))
							.filter((item) => item.value)
							.map((item) => JSON.stringify(item))
					),
				]
					.map((item) => JSON.parse(item))
					.sort((a, b) =>
						a.label.localeCompare(b.label)
					)
					.map((type) => (
						<option value={type.value}>
							{type.label}
						</option>
					))
			}

		</select>

	</div>

	<div class="table-wrapper">

		<table class="item-table">

			<thead>

				<tr>

					<th class="name-column">
						<button
							type="button"
							class="sort-button"
							data-sort="name"
						>
							Name
							<span class="sort-arrow">↑</span>
						</button>
					</th>

					<th class="type-column">
						<button
							type="button"
							class="sort-button"
							data-sort="type"
						>
							Type
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="weight-column">
						<button
							type="button"
							class="sort-button"
							data-sort="weight"
						>
							Weight
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="stat-column">
						<button
							type="button"
							class="sort-button"
							data-sort="armor"
						>
							Armor
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="stat-column">
						<button
							type="button"
							class="sort-button"
							data-sort="attack"
						>
							Attack
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="stat-column">
						<button
							type="button"
							class="sort-button"
							data-sort="defense"
						>
							Defense
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="stat-column">
						<button
							type="button"
							class="sort-button"
							data-sort="speed"
						>
							Speed
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="stat-column">
						<button
							type="button"
							class="sort-button"
							data-sort="range"
						>
							Range
							<span class="sort-arrow">↕</span>
						</button>
					</th>

					<th class="requirement-column">
						<button
							type="button"
							class="sort-button"
							data-sort="requirement"
						>
							Requirement
							<span class="sort-arrow">↕</span>
						</button>
					</th>

				</tr>

			</thead>

			<tbody id="items-body">

				{
					items.map((item) => (
						<tr
							data-name={item.name.toLowerCase()}
							data-type={item.typeValue}
							data-weight={item.weight}
							data-armor={item.armor ?? ""}
							data-attack={item.attack ?? ""}
							data-defense={item.defense ?? ""}
							data-speed={item.speed ?? ""}
							data-range={item.range ?? ""}
							data-requirement={String(item.requirement).toLowerCase()}
						>

							<td class="item-name">

								<a
									href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/equipment/${item.slug}/`}
								>

									{item.image ? (
										<img
											src={item.image}
											alt=""
											class="item-table-image"
											width="28"
											height="28"
										/>
									) : null}

									<span>
										{item.name}
									</span>

								</a>

							</td>

							<td class="item-type">
								{item.type || "—"}
							</td>

							<td class="item-weight">
								{item.weight || "—"}
							</td>

							<td class="item-stat">
								{item.armor ?? "—"}
							</td>

							<td class="item-stat">
								{item.attack ?? "—"}
							</td>

							<td class="item-stat">
								{item.defense ?? "—"}
							</td>

							<td class="item-stat">
								{item.speed ?? "—"}
							</td>

							<td class="item-stat">
								{item.range ?? "—"}
							</td>

							<td class="item-requirement">
								{item.requirement || "—"}
							</td>

						</tr>
					))
				}

			</tbody>

		</table>

	</div>

	<p
		id="no-results"
		class="no-results"
		hidden
	>
		No equipment found.
	</p>

</div>

<script>
	const table =
		document.querySelector(".items-table");

	if (table) {

		const searchInput =
			table.querySelector("#item-search");

		const typeSelect =
			table.querySelector("#item-type");

		const tbody =
			table.querySelector("#items-body");

		const noResults =
			table.querySelector("#no-results");

		const sortButtons =
			table.querySelectorAll(".sort-button");

		let sortKey = "name";
		let sortDirection = "asc";

		const getSortValue = (row, key) => {

			switch (key) {

				case "name":
					return row.dataset.name || "";

				case "type":
					return row.dataset.type || "";

				case "weight":
					return parseFloat(
						row.dataset.weight || "0"
					);

				case "armor":
					return parseFloat(
						row.dataset.armor || "0"
					);

				case "attack":
					return parseFloat(
						row.dataset.attack || "0"
					);

				case "defense":
					return parseFloat(
						row.dataset.defense || "0"
					);

				case "speed":
					return parseFloat(
						row.dataset.speed || "0"
					);

				case "range":
					return parseFloat(
						row.dataset.range || "0"
					);

				case "requirement":
					return row.dataset.requirement || "";

				default:
					return "";
			}

		};

		const updateTable = () => {

			const search =
				searchInput?.value
					.toLowerCase()
					.trim() || "";

			const type =
				typeSelect?.value || "all";

			const rows = Array.from(
				tbody.querySelectorAll("tr")
			);

			rows.forEach((row) => {

				const name =
					row.dataset.name || "";

				const rowType =
					row.dataset.type || "";

				const matchesSearch =
					name.includes(search);

				const matchesType =
					type === "all" ||
					rowType === type;

				row.hidden =
					!(matchesSearch && matchesType);

			});

			const visibleRows =
				rows.filter(
					(row) => !row.hidden
				);

			visibleRows.sort((a, b) => {

				const aValue =
					getSortValue(
						a,
						sortKey
					);

				const bValue =
					getSortValue(
						b,
						sortKey
					);

				if (
					typeof aValue === "string" &&
					typeof bValue === "string"
				) {

					const result =
						aValue.localeCompare(
							bValue,
							undefined,
							{
								sensitivity: "base",
							}
						);

					return sortDirection === "asc"
						? result
						: -result;

				}

				return sortDirection === "asc"
					? aValue - bValue
					: bValue - aValue;

			});

			visibleRows.forEach((row) => {

				tbody.appendChild(row);

			});

			noResults.hidden =
				visibleRows.length !== 0;

		};

		sortButtons.forEach((button) => {

			button.addEventListener(
				"click",
				() => {

					const newKey =
						button.dataset.sort;

					if (!newKey) {
						return;
					}

					if (sortKey === newKey) {

						sortDirection =
							sortDirection === "asc"
								? "desc"
								: "asc";

					} else {

						sortKey = newKey;
						sortDirection = "asc";

					}

					sortButtons.forEach(
						(otherButton) => {

							const arrow =
								otherButton.querySelector(
									".sort-arrow"
								);

							if (
								otherButton === button
							) {

								arrow.textContent =
									sortDirection === "asc"
										? "↑"
										: "↓";

							} else {

								arrow.textContent =
									"↕";

							}

						}
					);

					updateTable();

				}
			);

		});

		searchInput?.addEventListener(
			"input",
			updateTable
		);

		typeSelect?.addEventListener(
			"change",
			updateTable
		);

		updateTable();

	}
</script>

